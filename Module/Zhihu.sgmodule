#!name=Zhihu  
#!desc=Share the story you just made
#!author=blackmatrix7
#!homepage=https://github.com/blackmatrix7/ios_rule_script
#!category=blackmatrix7

[Rule]
# HTTP DNS
IP-CIDR,118.89.204.198/32,REJECT,no-resolve
IP-CIDR,103.41.167.237/32,REJECT,no-resolve
IP-CIDR6,2402:4e00:1200:ed00:0:9089:6dac:96b6/128,REJECT,no-resolve
# Other interceptors do not affect the domain name used
DOMAIN,mqtt.zhihu.com,REJECT
DOMAIN,sugar.zhihu.com,REJECT
DOMAIN,crash2.zhihu.com,REJECT
DOMAIN,appcloud.zhihu.com,REJECT
DOMAIN,appcloud2.in.zhihu.com,REJECT
DOMAIN,duga.zhihu.com,REJECT
DOMAIN,apm.zhihu.com,REJECT
# Block splash screen ads
URL-REGEX,^https?:\/\/api\.zhihu\.com\/commercial_api,REJECT
# Intercept ads below the answer
URL-REGEX,^https?:\/\/api\.zhihu\.com\/commercial_api\/answer/\d+/bottom-v2,REJECT
# Intercept requests that do not affect usage
URL-REGEX,^https?:\/\/api\.zhihu\.com\/message-push\/event,REJECT
# Block - Paid answers to user marketing guidance
URL-REGEX,^https:\/\/api\.zhihu\.com\/guide_center\/strategy,REJECT
# Block - Floating ads on the member page
URL-REGEX,^https?:\/\/api\.zhihu\.com\/bazaar\/float_window,REJECT
# Shielding - Data reporting
URL-REGEX,^https?:\/\/api\.zhihu.\com\/metrics\/report,REJECT
# Block - Suspected notification
URL-REGEX,^https?:\/\/api\.zhihu\.com\/settings\/new\/notification,REJECT
# Blocking - Membership-related ads
URL-REGEX,^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header,REJECT

[Map Local]
# Remove the message notification corner icon
^https?:\/\/api\.zhihu\.com\/(notifications\/v\d\/count) data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"
# Remove ads at the top of the recommendation page
^https?:\/\/api\.zhihu\.com\/root\/window data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"
# Block in-app pop-ups
^https?:\/\/api\.zhihu\.com\/me\/guides data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"
# Remove the most frequently visited following page
^https?:\/\/api\.zhihu\.com\/moments\/recent data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"
# Block ads at the top of recommendation pages
^https?:\/\/api\.zhihu\.com\/api\/v4\/ecom_data\/config data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"
# Suspected red dot for content update on recommendation pages
^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/tag_config data=" https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"
# Banners for some recommendation tab pages
^https?:\/\/api\.zhihu\.com\/content-distribution-core\/sections\/ data=" https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"

[Script]
# Obtaining User Information - Isolating user data, enabling local memberships, etc
Tetsuya_Processing User Information = type=http-response,requires-body=1,max-size=0,pattern=^https?:\/\/api\.zhihu\.com\/people\/,script-path=https://gist.githubusercontent.com/blackmatrix7/ f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# Keyword Blocking - Unlock local keyword blocking features, which requires enabling local VIP
Tetsuya_Unlock keyword blocking = type=http-request,requires-body=1,max-size=0,pattern=^https?:\/\/api\.zhihu\.com\/feed-root\/block,script-path=https://gist.githubusercontent. com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# Optimize software configuration – Optimize the provided configuration files to achieve certain effects
Tetsuya_Optimizes recommendation tab = type=http-response,requires-body=1,max-size=0,pattern=^https?:\/\/api\.zhihu\.com\/root\/tab\/v2,script-path=https://gist.githubusercontent. com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# Recommendation Page - Remove articles published by blacklisted users, remove ads, and customize some blocking items
Tetsuya_Recommendation Page Optimization = type=http-response,requires-body=1,max-size=0,timeout=30,pattern=^https:\/\/(api|web-render)\.zhihu\.com\/topstory\/recommend,script-path=https:// gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# Answer List - Remove answers from blacklisted users and remove advertisements
Tetsuya_Answer List Optimization = type=http-response,requires-body=1,max-size=0,pattern=^https:\/\/api\.zhihu\.com\/questions\/\d+\/feeds?,script-path=https://gist.githubusercontent. com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
