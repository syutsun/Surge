# Rewrites: 2; routing rules: 2; MITM hostnames: 1
# Original script is mirrored byte-for-byte; no supplementary rules.

[Rule]
DOMAIN,ad.51wnl-cq.com,REJECT
DOMAIN,adn.51wnl-cq.com,REJECT

[Script]
Wannianli_1 = type=http-response, pattern=^https?:\/\/r\.51wnl-cq\.com\/api\/Member\/IsMember, script-path=https://raw.githubusercontent.com/syutsun/Surge/main/Scripts/wannianli.vip.js, requires-body=true, max-size=-1, timeout=60, script-update-interval=86400
Wannianli_2 = type=http-response, pattern=https://r.51wnl-cq\.com\/Api\/User\/GetExtInfo, script-path=https://raw.githubusercontent.com/syutsun/Surge/main/Scripts/wannianli.vip.js, requires-body=true, max-size=-1, timeout=60, script-update-interval=86400

[MITM]
hostname = %APPEND% r.51wnl-cq.com
